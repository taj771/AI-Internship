# Copy this file to .env and fill in the values. .env is gitignored.

# OpenAI — used for both chat completions and embeddings.
OPENAI_API_KEY=

# Pinecone — free Starter key from https://app.pinecone.io (starts with pcsk_).
PINECONE_API_KEY=

# Not secrets. The index name is ours to choose; lowercase, digits and hyphens
# only. The embedding model is pinned here so ingest and query provably use the
# same one — mixing models produces silently meaningless search results.
PINECONE_INDEX_NAME=week2-rag
EMBEDDING_MODEL=text-embedding-3-small

# Chunking defaults. Overridable per request on POST /ingest.
# Overlap repeats the tail of each chunk at the head of the next, so a sentence
# cut in half by a chunk boundary still survives intact in one of them.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
