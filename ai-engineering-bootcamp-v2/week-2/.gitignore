# Environment — never commit real keys.
# `.env` alone matches only that exact name, so a stray .env.backup or
# .env.local would slip through untracked and be easy to commit by accident.
# Ignore the whole family, then re-include the template, which holds no values.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
.venv/
env/
